# Copy to .env for local development.
NODE_ENV=development

# Port the API listens on. API_PORT wins over PORT because some hosts
# pre-set PORT for their own tooling.
API_PORT=4000

# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string. Keep the real value in .env only — never commit it.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URI=

# How long a signed-in session stays valid.
SESSION_TTL_DAYS=7

# Session cookie signing secret (32+ characters in production).
JWT_SECRET=

# --- Live vehicle status (GPSWOX tracking server) -------------------------
# Use a dedicated read-only GPSWOX user. These stay on the server only.
TRACKING_API_URL=
TRACKING_EMAIL=
TRACKING_PASSWORD=
# How often the backend refreshes vehicle status (seconds, minimum 30).
TRACKING_SYNC_SECONDS=300
# A vehicle with no data for this many hours is shown as Inactive.
TRACKING_INACTIVE_HOURS=24
# Time zone of the tracking server's timestamps.
TRACKING_TIME_OFFSET=+05:00

# --- Complaint emails to customers (Nodemailer SMTP) ----------------------
# Leave SMTP_HOST empty to send nothing; messages are then recorded as
# "not configured". Use an app password or a dedicated sending account.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TrackMaster <support@your-domain.example>"
MAIL_BUSINESS_NAME=TrackMaster
# How often failed emails are retried (seconds, minimum 5).
MAIL_RETRY_SWEEP_SECONDS=60

# --- Robocall results (webhook) -------------------------------------------
# Long random string. The provider calls
#   https://YOUR-SERVER/api/webhooks/robocall?token=<this value>
# Leave empty to keep the webhook closed.
ROBOCALL_WEBHOOK_SECRET=
