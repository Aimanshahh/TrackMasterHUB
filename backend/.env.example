# Copy to .env for local development.
NODE_ENV=development

# Port the API listens on. API_PORT wins over PORT because some hosts
# pre-set PORT for their own tooling.
API_PORT=4000

# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string. Keep the real value in .env only — never commit it.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URI=

# How long a signed-in session stays valid.
SESSION_TTL_DAYS=7

# Session cookie signing secret (32+ characters in production).
JWT_SECRET=

# --- Live vehicle status (GPSWOX tracking server) -------------------------
# Use a dedicated read-only GPSWOX user. These stay on the server only.
TRACKING_API_URL=
TRACKING_EMAIL=
TRACKING_PASSWORD=
# How often the backend refreshes vehicle status (seconds, minimum 30).
TRACKING_SYNC_SECONDS=300
# A vehicle with no data for this many hours is shown as Inactive.
TRACKING_INACTIVE_HOURS=24
# Time zone of the tracking server's timestamps.
TRACKING_TIME_OFFSET=+05:00
