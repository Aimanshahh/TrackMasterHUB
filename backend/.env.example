[TEMPLATE]
# Copy to .env for local development. Never commit the real .env.
NODE_ENV=development

# Port the API listens on. API_PORT wins over PORT because some hosts
# pre-set PORT for their own tooling.
API_PORT=4000

# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string. Keep the real value in .env only.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URI=

# How long a signed-in session stays valid.
SESSION_TTL_DAYS=7

# Session cookie signing secret (32+ characters in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Live vehicle status and installation tests (GPSWOX tracking server) ----
# Use the user_api_hash from GPSWOX. Keep this value on the server only; it is
# never sent to the browser. Install a dedicated integration account if your
# portal supports one, and put its hash here.
TRACKING_API_URL=
TRACKING_API_HASH=

# Multiple portals are queried sequentially, highest priority first. Keep the
# hashes server-side. Portal 1 active is also used for the installation tests.
PORTAL_1_ACTIVE_URL=
PORTAL_1_ACTIVE_HASH=
PORTAL_1_EXPIRED_URL=
PORTAL_1_EXPIRED_HASH=
PORTAL_2_L8_URL=
PORTAL_2_L8_HASH=

# The tracking account that holds the technicians' stock. Its groups are named
# after the technicians; it is read on its own (never merged with the customer
# portals) for stock matching and as a fallback for installation test readings.
PORTAL_1_TECHNICIANSTOCK_URL=
PORTAL_1_TECHNICIANSTOCK_HASH=

# How often the backend refreshes vehicle status (seconds, minimum 30).
TRACKING_SYNC_SECONDS=300
# A vehicle with no data for this many hours is shown as Inactive.
TRACKING_INACTIVE_HOURS=24
# Time zone of the tracking server's timestamps.
TRACKING_TIME_OFFSET=+05:00
# Maximum time allowed for the (potentially large) device-list response.
TRACKING_TIMEOUT_MS=60000

# --- Complaint emails to customers (Nodemailer SMTP) -----------------------
# Leave SMTP_HOST empty to send nothing; messages are then recorded as
# "not configured". Use an app password or a dedicated sending account.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TrackMaster <sender@example.com>"
MAIL_BUSINESS_NAME=TrackMaster
# How often failed emails are retried (seconds, minimum 5).
MAIL_RETRY_SWEEP_SECONDS=60

# --- WhatsApp complaint updates --------------------------------------------
# The gateway must be reachable from this backend process.
WHATSAPP_GATEWAY_URL=http://localhost:4100/api/send-update
# Must equal WEBHOOK_API_KEY in whatsapp-gateway/.env
WHATSAPP_GATEWAY_API_KEY=
WHATSAPP_GATEWAY_TIMEOUT_MS=10000
# Number printed in the "Helpline Numbers" WhatsApp template ([Helpline Number])
HELPLINE_NUMBER=
# Pause between messages in a bulk send (the gateway allows about 30 a minute)
WHATSAPP_BULK_DELAY_MS=2200

# --- Robocall results (webhook) --------------------------------------------
# Long random string. The provider calls
#   https://YOUR-SERVER/api/webhooks/robocall?token=<this value>
# Leave empty to keep the webhook closed.
ROBOCALL_WEBHOOK_SECRET=

# Customer app logins are created on approval as <VRN>@<domain>.
CUSTOMER_APP_LOGIN_DOMAIN=
CUSTOMER_APP_DEFAULT_PASSWORD=
# How recent a portal reading must be to count towards an installation test.
PORTAL_READING_FRESH_MINUTES=30
